rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ──────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── User subcollections (private data) ─────────────────────────
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Households ────────────────────────────────────────────────
    match /households/{hhId} {
      allow read: if request.auth != null && isMember(hhId);
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin(hhId);

      match /members/{memberId} {
        allow read: if request.auth != null && isMember(hhId);
        allow write: if request.auth != null && isAdmin(hhId);
      }

      match /activity/{actId} {
        allow read: if request.auth != null && isMember(hhId);
        allow create: if request.auth != null && isMember(hhId);
        allow delete: if request.auth != null && isAdmin(hhId);
      }

      match /messages/{msgId} {
        allow read: if request.auth != null && isMember(hhId);
        allow create: if request.auth != null && isMember(hhId);
        allow delete: if request.auth != null && isAdmin(hhId);
      }
    }

    // ── App config (readable by all, no client write) ─────────────
    match /app_config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Helper functions ──────────────────────────────────────────
    function isMember(hhId) {
      return exists(/databases/$(database)/documents/households/$(hhId)/members/$(request.auth.uid));
    }

    function isAdmin(hhId) {
      return get(/databases/$(database)/documents/households/$(hhId)/members/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
